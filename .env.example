VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Côté serveur uniquement (Vercel > Settings > Environment Variables) ---
# SUPABASE_SERVICE_ROLE_KEY=        clé service_role Supabase (création de comptes et mots de passe)
# PAJ_EMAIL=                        identifiant du portail PAJ GPS (contrôle véhicules)
# PAJ_PASSWORD=                     mot de passe de cet identifiant PAJ
# CRON_SECRET=                      texte au hasard : protège le contrôle automatique mensuel
